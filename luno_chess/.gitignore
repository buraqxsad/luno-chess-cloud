*.zip

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Keep generated visual runs out, but retain test/goldens and explicitly
# selected QA fixtures in the clean cloud transfer.
**/node_modules/
**/*.apk
**/*.aab
/backups/
/release-artifacts/
