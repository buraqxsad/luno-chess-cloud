# Optional local administrative/backend variables. No secrets are supplied.
# Do not copy this file to .env and deploy it without reviewing each variable.
# Firebase/Google Cloud supplies normal function identity in production.
GOOGLE_APPLICATION_CREDENTIALS=
GCLOUD_PROJECT=
FIREBASE_DATABASE_URL=
LUNO_BILLING_RTDN_TOPIC=

# Set both only when intentionally running local Firebase emulators.
# Leave unset for real Firebase. The native Android client does not read .env.
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_DATABASE_EMULATOR_HOST=
LUNO_DB_EMULATOR_NAMESPACE=
