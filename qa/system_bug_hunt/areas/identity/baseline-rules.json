{
  "rules": {
    ".read": false,
    ".write": false,

    "matchesV1": {
      "$matchId": {
        "public": {
          ".read": "auth != null && root.child('users').child(auth.uid).exists() && data.child('participants').child(auth.uid).val() === true",
          ".write": false
        },
        "private": {
          "$uid": {
            ".read": "auth != null && root.child('users').child(auth.uid).exists() && auth.uid === $uid && root.child('matchesV1').child($matchId).child('public').child('participants').child(auth.uid).val() === true",
            ".write": false
          }
        }
      }
    },
    "matchSecretsV1": {".read": false, ".write": false, ".indexOn": ["status", "settlementStatus"]},
    "battleV1Control": {".read": false, ".write": false},
    "battleV1Accounts": {"$uid": {".read": "auth != null && auth.uid === $uid", ".write": false}},
    "battleV1Ratings": {".read": "auth != null", ".write": false, ".indexOn": ["rating"]},
    "battleRollout": {
      "config": {".read": false, ".write": false},
      "status": {".read": "auth != null", ".write": false}
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "publicProfiles": {
      ".read": "auth != null",
      ".write": false,
      ".indexOn": ["trophies", "collectionScore", "seasonScore", "wins", "username", "playerCode"]
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online','lastSeen']) && newData.child('online').isBoolean() && newData.child('lastSeen').isNumber() && newData.child('lastSeen').val() <= now + 10000"
      }
    },
    "usernames": {
      ".read": false,
      ".write": false,
      ".indexOn": [".value"]
    },
    "playerCodes": {
      ".read": false,
      ".write": false,
      ".indexOn": [".value"]
    },
    "serverRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "purchaseClaims": {
      ".read": false,
      ".write": false,
      ".indexOn": ["uid"]
    },
    "billingEvents": {
      ".read": false,
      ".write": false
    },
    "billingSignals": {
      ".read": false,
      ".write": false
    },
    "auditLogs": {
      ".read": false,
      ".write": false
    },
    "accountLinkTickets": {
      ".read": false,
      ".write": false,
      ".indexOn": ["uid"]
    },
    "serverRateLimits": {
      ".read": false,
      ".write": false
    },
    "messageThrottle": {
      ".read": false,
      ".write": false
    },
    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "blockedBy": {
      ".read": false,
      ".write": false
    },
    "mutes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "moderationReports": {
      ".read": false,
      ".write": false,
      ".indexOn": ["reporterUid", "targetUid", "status"]
    },
    "accountDeletions": {
      ".read": false,
      ".write": false
    },
    "deviceTokens": {
      ".read": false,
      ".write": false
    },
    "deletedAccounts": {
      ".read": false,
      ".write": false
    },

    "rooms": {
      "$roomId": {
        ".read": "auth != null && data.child('players').child(auth.uid).exists()",
        ".write": false
      }
    },
    "queue": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "matches": {
      "$matchId": {
        ".read": "auth != null && data.child('players').child(auth.uid).exists()",
        ".write": false
      }
    },
    "matchHistory": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "rankedState": {
      ".read": false,
      ".write": false,
      "matches": {
        ".indexOn": ["status", "settlementStatus"]
      }
    },
    "rankedPlayers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "rankedMatchViews": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "rankedReplays": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "rankedMessages": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "outgoingFriendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "matchInvites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "matchInviteThrottle": {
      ".read": false,
      ".write": false
    },
    "socialLocks": {
      ".read": false,
      ".write": false
    },
    "friendlyRooms": {
      ".read": false,
      ".write": false
    },
    "friendlyRoomByUser": {
      ".read": false,
      ".write": false
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        ".indexOn": ["fromUid"]
      }
    },
    "dmInbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "dm": {
      "$conversationId": {
        ".read": "auth != null && root.child('users').child(auth.uid).exists() && !root.child('deletedAccounts').child(auth.uid).exists() && data.child('members').child(auth.uid).val() === true",
        ".write": false
      }
    }
  }
}
